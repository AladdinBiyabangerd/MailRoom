PORT=8090
NODE_ENV=development

# Postgres — either DATABASE_URL or discrete fields
DATABASE_URL=postgresql://mailroom:mailroom@localhost:5432/mailroom?schema=public
PGHOST=localhost
PGPORT=5432
PGUSER=mailroom
PGPASSWORD=mailroom
PGDATABASE=mailroom

APP_SECRET_KEY=change-me-to-a-long-secret-at-least-sixty-four-bytes-long-please!!
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

ADMIN_PUBLIC_BASE_URL=http://localhost:8090
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=admin@mailroom.local
ADMIN_BOOTSTRAP_PASSWORD=Admin123
ADMIN_BOOTSTRAP_FIRST_NAME=Mail
ADMIN_BOOTSTRAP_LAST_NAME=Room

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
ADMIN_MAIL_FROM=

ADMIN_ACCESS_TOKEN_TTL_MINUTES=480
ADMIN_REFRESH_TOKEN_VALIDITY_DAYS=7
ADMIN_PASSWORD_RESET_EXPIRATION_MINUTES=15
ADMIN_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
